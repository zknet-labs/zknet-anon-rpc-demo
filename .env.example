# ZKNet Anon-RPC Demo — Environment Configuration
# Copy to .env and edit as needed

# Katzenpost version (tag/branch for git submodule)
KATZENPOST_REF=v0.0.90

# VPS mixnet configuration
VPS_HOST=zknode-mix
VPS_GATEWAY_IP=185.92.181.101
VPS_GATEWAY_PORT=30004
VPS_CLIENT_PATH=katzenpost/vps-config/client/client.toml

# Ethereum RPC for contract deployment / services (default: Sepolia)
RPC_URL=https://ethereum-sepolia.publicnode.com

# Private key for contract deployment / tx broadcast (must have Sepolia ETH)
PRIVATE_KEY=

# walletshield listen addresses
WS_HTTP_ADDR=127.0.0.1:9200
WS_KPS_ADDR=0.0.0.0:9201

# Dashboard
DASHBOARD_PORT=3517